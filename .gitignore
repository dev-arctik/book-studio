# .gitignore
# Keeps book content and large local tools out of git: this repo holds only code and docs.

# Book content — internal ISKCON material, never committed (scans, OCR, finished PDFs/EPUBs)
books/
output/
*.pdf
*.epub
*.docx
*.azw3
*.mobi
# Per-book settings hold titles, captions and OCR-fix text fragments from the books — they live in the library, outside
# the repo; ignored anywhere here in case a copy is dropped in
book_meta.json

# Local tools, models and environments (large, rebuilt per machine)
tools/
.cache/
.venv/
*.gguf

# Packaged app builds (software/)
build/
dist/

# Python and OS clutter
__pycache__/
*.pyc
.DS_Store

# Secrets
.env
.env.*
!.env.example
